                  <story-point caption='Flavors Across Cities: Each city reveals distinct cuisine preferences shaping local demand . ' captured-sheet='Flavors Across Cities' id='12' />
                  <story-point caption='Order Distribution by Age Group: Adults lead order volumes, especially in casual dining.' captured-sheet='Order Distribution by Age Group and Restaurant Segment' id='13' />
                  <story-point caption='Orders by Company Type &amp; Meal: Corporate orders peak during lunch and dinner hours.' captured-sheet='Company vs Meal Type' id='14' />
                  <story-point caption='Customer Preferences Across Cuisines: North and South Indian cuisines dominate overall choices.' captured-sheet='Distribution of Customer Preferences Across Cuisines' id='15' />
                  <story-point caption='Customer Rating by Meal Type: Dinner and lunch earn the highest satisfaction ratings.' captured-sheet='Customer Rating Analysis by Meal Type' id='16' />
                  <story-point caption='Cities by Order Volume: Bangalore records the highest food order activity.' captured-sheet='Cities by Order Volume' id='17' />
                  <story-point caption='Revenue Contribution by Meal Type: Dinner drives the largest share of total revenue.' captured-sheet='Revenue Contribution by Meal Type' id='18' />
                  <story-point caption='Customer Preferences Across Cuisines: North and South Indian cuisines dominate overall choices.' captured-sheet='Distribution of Delivery Time Across Orders' id='19' />
                  <story-point caption='Delivery Time Distribution: Delivery times remain consistent across major cities.' captured-sheet='Distribution of Delivery Time Across Orders' id='23' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
