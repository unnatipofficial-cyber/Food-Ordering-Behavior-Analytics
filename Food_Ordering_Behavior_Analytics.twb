    <dashboard name='Food Ordering Behavior Story' type='storyboard'>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='373' />
        </style-rule>
      </style>
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='4357' id='3' type-v2='title' w='98426' x='787' y='830' />
            <zone h='10477' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='5187' />
            <zone h='83506' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='15664'>
              <flipboard active-id='10' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Flavors Across Cities: Each city reveals distinct cuisine preferences shaping local demand . ' captured-sheet='Flavors Across Cities' id='1' />
                  <story-point caption='Order Distribution by Age Group: Adults lead order volumes, especially in casual dining.' captured-sheet='Order Distribution by Age Group and Restaurant Segment' id='2' />
                  <story-point caption='Orders by Company Type &amp; Meal: Corporate orders peak during lunch and dinner hours.' captured-sheet='Company vs Meal Type' id='3' />
                  <story-point caption='Customer Preferences Across Cuisines: North and South Indian cuisines dominate overall choices.' captured-sheet='Distribution of Customer Preferences Across Cuisines' id='4' />
                  <story-point caption='Customer Rating by Meal Type: Dinner and lunch earn the highest satisfaction ratings.' captured-sheet='Customer Rating Analysis by Meal Type' id='5' />
                  <story-point caption='Cities by Order Volume: Bangalore records the highest food order activity.' captured-sheet='Cities by Order Volume' id='6' />
                  <story-point caption='Revenue Contribution by Meal Type: Dinner drives the largest share of total revenue.' captured-sheet='Revenue Contribution by Meal Type' id='7' />
                  <story-point caption='Customer Preferences Across Cuisines: North and South Indian cuisines dominate overall choices.' captured-sheet='Distribution of Delivery Time Across Orders' id='8' />
                  <story-point caption='Delivery Time Distribution: Delivery times remain consistent across major cities.' captured-sheet='Distribution of Delivery Time Across Orders' id='9' />
                  <story-point caption='Analyzing Order Value vs. Delivery Fee Dynamics' captured-sheet='Order Value vs Delivery Fee' id='10' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{63856614-C236-4005-B30F-910C3981086B}' />
    </dashboard>
